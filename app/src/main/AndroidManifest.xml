<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to read LinkProperties, which is how we detect that Android's
         Private DNS (DoT) is switched on. Private DNS bypasses the DNS servers a
         VpnService installs, which would silently break every *.<tld> lookup, so
         we surface it as a warning rather than letting it fail mysteriously. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The Private DNS warning matters most when the user is NOT in this app —
         they hit the failure in a browser. Runtime-granted from API 33; denial is
         handled (the in-app alert still fires). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The Town OS control API is plain HTTP on :5309 (the systemcontroller
         calls ListenAndServe, not ListenAndServeTLS), so cleartext to the box is
         required. It is scoped to private ranges + .home in network_security_config
         rather than enabled globally. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TownOs">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The tunnel itself is com.wireguard.android.backend.GoBackend$VpnService,
             declared by the WireGuard tunnel AAR. We do not redeclare it here. -->
    </application>

</manifest>
